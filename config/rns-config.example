# Example Reticulum config for rns-geo. rns-geo is a leaf/edge service: it does
# NOT run its own transport. Point it at a Reticulum instance you already run.
#
# Copy to a config dir (e.g. ./config) as the file named `config`, then run the
# server with  --config /path/to/that/dir.
#
# NOTE: interface_enabled = True is REQUIRED on every interface block. RNS
# silently skips any block without it.

[reticulum]
  enable_transport = No
  share_instance = No
  instance_name = rns_geo

[logging]
  loglevel = 4

[interfaces]
  # Option A (recommended): ride an rnsd you already run, via its loopback
  # TCPServerInterface. This is how you co-locate rns-geo next to a full node.
  [[Local rnsd]]
    type = TCPClientInterface
    interface_enabled = True
    enabled = True
    target_host = 127.0.0.1
    target_port = 4343

  # Option B: connect straight to any public/transport RNS node instead of, or
  # in addition to, a local rnsd. Uncomment and set a real peer.
  # [[Public Peer]]
  #   type = TCPClientInterface
  #   interface_enabled = True
  #   enabled = True
  #   target_host = example-node.tld
  #   target_port = 4242
